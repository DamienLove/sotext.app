<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />
    <application
        android:allowBackup="false"
        android:label="PulseLink Wear"
        android:icon="@drawable/ic_wear_logo"
        android:theme="@android:style/Theme.DeviceDefault">

        <service
            android:name="com.pulselink.wear.PulseLinkWatchFaceService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.action.WATCH_FACE" />
            </intent-filter>
            <meta-data android:name="androidx.wear.watchface.preview" android:resource="@drawable/ic_wear_logo" />
        </service>

    </application>
</manifest>
