<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_card_dark" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/widget_gold_dark" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_card_dark" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/widget_gold_light" />
        </shape>
    </item>
</layer-list>
