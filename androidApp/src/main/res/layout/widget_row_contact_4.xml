<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_4"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/contact_status_4"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_centerVertical="true"
        android:src="@drawable/widget_status_dot_green" />

    <TextView
        android:id="@+id/contact_name_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/contact_status_4"
        android:layout_marginStart="10dp"
        android:text="Contact"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/contact_role_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/contact_name_4"
        android:layout_alignStart="@id/contact_name_4"
        android:text="ROLE"
        android:textColor="@color/widget_text_secondary"
        android:textAllCaps="true"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/widget_divider" />
</RelativeLayout>
